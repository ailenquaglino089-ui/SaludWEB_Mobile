# ============================================================
# Variables de entorno - SaludWEB (repositorio_mobile / Expo)
# ============================================================
# Copia este archivo a ".env" y completá los valores:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Linux / macOS)
#
# NUNCA subas tu .env al repositorio (ya está en .gitignore).
#
# EXPO_PUBLIC_ es el prefijo OBLIGATORIO: Expo (SDK 49 en adelante)
# solo inyecta en la app las variables que arrancan con ese prefijo.
# Cualquier otra que pongas acá existe para el equipo, no para el
# código, y además NO viaja al bundle (buena práctica: en un .env
# de Expo nunca va nada secreto, porque el JS del celular es
# legible por cualquiera).
#
# Los valores se leen en src/config.js. Si no hay archivo .env,
# se usan los mismos defaults que ya estaban escritos en el código,
# así que crearlo es opcional.
# ============================================================

# ------------------------------------------------------------
# API_URL - URL base de la API, incluyendo el /api final
# ------------------------------------------------------------
# Notas según dónde corras la app:
#   - Emulador Android: el host de tu PC se llama 10.0.2.2, no localhost.
#   - Celular físico: la IP local de tu PC en la red (ej: http://192.168.1.20).
#   - Navegador (expo start --web): alcanza con localhost.
#   - Backend nativo (php -S): http://127.0.0.1:8000/api
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api

# ------------------------------------------------------------
# Ajustes generales
# ------------------------------------------------------------
# Milisegundos que la app espera antes de cortar una petición que
# no responde (evita cuelgues en el celular).
EXPO_PUBLIC_TIMEOUT_MS=15000

# Registros por página en los listados. Debe coincidir con el
# por_pagina que acepta el backend.
EXPO_PUBLIC_POR_PAGINA=10

# ------------------------------------------------------------
# SSO (Google / Microsoft) - OPCIONAL
# ------------------------------------------------------------
# Vacío = el botón correspondiente queda oculto en la pantalla de
# login (y el backend responde 501 si alguien lo intenta igual).
# Google: "Client ID de aplicación web" de Google Cloud Console.
EXPO_PUBLIC_SSO_GOOGLE_CLIENT_ID=
# Microsoft: "Application (client) ID" de una app pública de Entra ID.
EXPO_PUBLIC_SSO_MICROSOFT_CLIENT_ID=
# Tenant de Microsoft: 'common' acepta cuentas personales y corporativas.
EXPO_PUBLIC_SSO_MICROSOFT_TENANT=common
